---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const heroImage = '/images/IMG_0632.jpg';
const heroImageAlt = 'Rob and a friend smiling outdoors by the water at sunset';

const chapters = [
  {
    eyebrow: 'Origins',
    title: 'Where it started',
    note: [
      'Tulsa, Oklahoma',
      'Born and raised here',
      'It still feels easy, if not fully comfortable',
      'A place where I sometimes felt challenged, but never grew',
    ],
    image: '/images/tulsa-route66-gateway.png',
    imageAlt: 'The Route 66 Tulsa gateway arch sign against a blue sky',
  },
  {
    eyebrow: 'Somewhere that changed me',
    title: 'A place that changed me',
    note: [
      'Buenos Aires, Argentina',
      'A completely brand new experience',
      'Challenged a lot of my assumptions',
      'This is where I really grew',
    ],
    image: '/images/buenos-aires-obelisco-sunset.jpg',
    imageAlt: 'The Obelisco de Buenos Aires at sunset, framed by the buildings of Avenida 9 de Julio',
  },
  {
    eyebrow: 'What drives me',
    title: 'Top priorities',
    note: [
      'Julia and our family',
      'Everything is in support of the life we want to build',
      'Nothing has improved my life more than when she entered it',
    ],
    image: '/images/julia-and-chance.jpg',
    imageAlt: 'Julia smiling with our dog, Chance',
  },
  {
    eyebrow: 'Someone who shaped me',
    title: 'Matt Drayer',
    note: [
      'CTO at Operix',
      'My first technical mentor',
      'Believed in me and pushed me to do more',
    ],
    image: '/images/matt-drayer.png',
    imageAlt: 'Matt Drayer',
  },
  {
    eyebrow: 'The leap',
    title: 'Joining Webflow',
    note: [
      'I caught lightning in a bottle',
      'I love that things are always changing and the work stays interesting',
      'Webflow has challenged me to learn and grow',
    ],
    image: '/images/speaking-at-wfc24.jpg',
    imageAlt: 'Rob speaking on stage at Webflow Conf',
  },
  {
    eyebrow: 'Looking ahead',
    title: "What's next",
    note: 'Joining the SA team?',
    compact: true,
    roster: [
      { src: '/images/sa-team/jordan-maslyn.png', alt: 'Jordan Maslyn', objectPosition: '50% 20%' },
      { src: '/images/sa-team/rachel-clark.png', alt: 'Rachel Clark', objectPosition: '50% 20%' },
      { src: '/images/sa-team/christina-dulude.png', alt: 'Christina Dulude' },
      { src: '/images/sa-team/jon-saxton.jpg', alt: 'Jon Saxton' },
      { src: '/images/sa-team/ben-parker.jpg', alt: 'Ben Parker', objectPosition: '50% 20%' },
      { src: '/images/sa-team/wadood-hussaini.jpg', alt: 'Wadood Hussaini' },
      { src: '/images/sa-team/blake-lam.jpg', alt: 'Blake Lam' },
    ],
    rosterExtras: [
      { src: '/images/sa-team/kc-katalbas.png', alt: 'KC Katalbas' },
      { src: '/images/sa-team/mj-zorick.jpg', alt: 'MJ Zorick' },
      { src: '/images/sa-team/cory-runnells.jpg', alt: 'Cory Runnells' },
      { src: '/images/sa-team/lennon-cole.jpg', alt: 'Lennon Cole' },
      { src: '/images/sa-team/brian-grapes.jpg', alt: 'Brian Grapes' },
      { src: '/images/sa-team/patrick-corsetti.jpg', alt: 'Patrick Corsetti' },
      { src: '/images/sa-team/raul-salido.jpg', alt: 'Raul Salido' },
      { src: '/images/sa-team/javier-barrera.jpg', alt: 'Javier Barrera' },
      { src: '/images/sa-team/jamie-taylor.jpg', alt: 'Jamie Taylor' },
      { src: '/images/sa-team/grant-sorbo.jpg', alt: 'Grant Sorbo' },
    ],
    joinSlot: { src: '/images/sa-team/rob-smith.png', alt: 'Rob Smith — an open spot on the team' },
  },
];

const teamChapter = chapters.find((c) => c.roster);
const rosterInitial = teamChapter?.roster.map(({ src, alt }) => ({ src, alt })) ?? [];
const rosterExtras = teamChapter?.rosterExtras ?? [];
---

<Layout title="Rob Smith — Biography">
  <Header />
  <main>
  <section class="hero">
    {heroImage ? (
      <img src={heroImage} alt={heroImageAlt} />
    ) : (
      <div class="hero-placeholder">Photo placeholder</div>
    )}
    <div class="hero-overlay">
      <div class="hero-content">
        <h1 class="page-heading">Biography</h1>
        <p class="intro">Some history and context about who I am and what drives me.</p>
      </div>
    </div>
  </section>

  <div class="chapters">
    {chapters.map((chapter, i) => (
      <div class:list={['chapter', i % 2 === 1 && 'chapter--reverse', chapter.compact && 'chapter--compact']}>
        <div class="chapter-media">
          {chapter.roster ? (
            <div class="roster" data-roster>
              {chapter.roster.map((p, idx) => (
                <img
                  class="roster-tile"
                  src={p.src}
                  alt={p.alt}
                  data-roster-tile={idx}
                  style={p.objectPosition ? `object-position: ${p.objectPosition};` : undefined}
                />
              ))}
              {chapter.joinSlot && (
                <div class="roster-tile roster-tile--join">
                  <img src={chapter.joinSlot.src} alt={chapter.joinSlot.alt} />
                  <span class="join-badge" aria-hidden="true">?</span>
                </div>
              )}
            </div>
          ) : chapter.image ? (
            <img
              src={chapter.image}
              alt={chapter.imageAlt}
              style={chapter.objectPosition ? `object-position: ${chapter.objectPosition};` : undefined}
            />
          ) : (
            <div class="chapter-placeholder">Photo placeholder</div>
          )}
          {chapter.credit && <span class="photo-credit">{chapter.credit}</span>}
        </div>
        <div class="chapter-text">
          <span class="chapter-eyebrow">{chapter.eyebrow}</span>
          <h2 class="chapter-title">{chapter.title}</h2>
          {Array.isArray(chapter.note) ? (
            <div class="chapter-note-lines">
              {chapter.note.map((line) => <p class="chapter-note">{line}</p>)}
            </div>
          ) : (
            <p class="chapter-note">{chapter.note}</p>
          )}
        </div>
      </div>
    ))}
  </div>
  </main>
  <Footer />
</Layout>

<script>
  const chapters = document.querySelectorAll('.chapter');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    chapters.forEach((chapter) => chapter.classList.add('in-view'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );

    chapters.forEach((chapter) => observer.observe(chapter));
  }
</script>

<script define:vars={{ initial: rosterInitial, extras: rosterExtras }}>
  const rosterEl = document.querySelector('[data-roster]');
  const tiles = rosterEl ? [...rosterEl.querySelectorAll('[data-roster-tile]')] : [];
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rosterEl && tiles.length && extras.length && !prefersReducedMotion) {
    const waiting = extras.slice().sort(() => Math.random() - 0.5);
    const displayed = initial.slice();

    extras.forEach((person) => {
      const preload = new Image();
      preload.src = person.src;
    });

    const busy = new Set();
    let lastTileIndex = -1;

    function swapRandomTile() {
      if (!waiting.length) return;
      const available = tiles.map((_, i) => i).filter((i) => !busy.has(i));
      if (!available.length) return;

      const candidates = available.length > 1 ? available.filter((i) => i !== lastTileIndex) : available;
      const tileIndex = candidates[Math.floor(Math.random() * candidates.length)];
      lastTileIndex = tileIndex;
      busy.add(tileIndex);

      const tile = tiles[tileIndex];
      const incoming = waiting.shift();
      const outgoing = displayed[tileIndex];
      waiting.push(outgoing);
      displayed[tileIndex] = incoming;

      tile.classList.add('roster-tile--fading');
      window.setTimeout(() => {
        tile.src = incoming.src;
        tile.alt = incoming.alt;
        tile.classList.remove('roster-tile--fading');
        busy.delete(tileIndex);
      }, 750);
    }

    window.setInterval(swapRandomTile, 3500);
    window.setTimeout(() => {
      window.setInterval(swapRandomTile, 3500);
    }, 2500);
  }
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 420px;
  }

  .hero img,
  .hero-placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero img {
    object-fit: cover;
    object-position: 50% 38%;
  }

  .hero-placeholder {
    border: 2px dashed var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0) 60%);
  }

  .hero-content {
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  .page-heading {
    color: #fff;
    font-size: 3rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }

  .intro {
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .chapters {
    margin-top: 4rem;
  }

  .chapter {
    display: flex;
    width: 100%;
    max-width: 100rem;
    margin: 0 auto 4rem;
    min-height: 70vh;
  }

  .chapter--reverse {
    flex-direction: row-reverse;
  }

  .chapter--compact {
    min-height: 34rem;
  }

  .chapter-media {
    position: relative;
    flex: 0 1 50%;
    min-width: 0;
  }

  .photo-credit {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.7rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .chapter-media > img,
  .chapter-placeholder {
    width: 100%;
    height: 70vh;
    display: block;
  }

  .chapter-media > img {
    object-fit: cover;
  }

  .chapter-placeholder {
    border: 2px dashed var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .roster {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 0.85rem;
    padding: 2rem;
  }

  .roster-tile {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    display: block;
    opacity: 1;
    transition: opacity 0.75s ease;
  }

  .roster-tile--fading {
    opacity: 0;
  }

  .roster-tile--join {
    position: relative;
    box-shadow: none;
    border: 3px dashed var(--color-accent);
    background: var(--color-accent-soft);
    padding: 4px;
  }

  .roster-tile--join img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .join-badge {
    position: absolute;
    bottom: -0.5rem;
    right: -0.5rem;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--color-accent-solid);
    color: var(--color-accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.05rem;
    border: 2px solid var(--color-bg);
  }

  .chapter-text {
    flex: 0 1 50%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem 4rem;
    max-width: 32rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s ease 0.6s, transform 0.7s ease 0.6s;
  }

  .chapter.in-view .chapter-text {
    opacity: 1;
    transform: translateY(0);
  }

  .chapter-eyebrow {
    display: block;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .chapter-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.1;
    margin: 0.35rem 0 0.5rem;
  }

  .chapter-note {
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  .chapter-note-lines .chapter-note {
    margin-bottom: 0.5rem;
  }

  .chapter-note-lines .chapter-note:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .hero {
      height: 50vh;
      min-height: 320px;
    }

    .hero-content {
      padding: 0 1.5rem 2rem;
    }

    .page-heading {
      font-size: 2rem;
    }

    .chapters {
      margin-top: 2.5rem;
    }

    .chapter,
    .chapter--reverse {
      flex-direction: column;
      margin-bottom: 2.5rem;
    }

    .chapter-media > img,
    .chapter-placeholder {
      height: 55vh;
      min-height: 0;
    }

    .chapter--compact {
      min-height: auto;
    }

    .roster {
      height: 22rem;
      padding: 1.25rem;
      gap: 0.6rem;
    }

    .join-badge {
      width: 1.5rem;
      height: 1.5rem;
      font-size: 0.85rem;
    }

    .chapter-text {
      padding: 2rem 1.5rem;
      max-width: none;
    }

    .chapter-title {
      font-size: 1.7rem;
    }
  }
</style>
