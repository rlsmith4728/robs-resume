---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const heroImage = '/images/IMG_0632.jpg';
const heroImageAlt = 'Rob and a friend smiling outdoors by the water at sunset';

const chapters = [
  {
    eyebrow: 'Origins',
    title: 'Where it started',
    note: 'Tulsa, Oklahoma.',
    image: '/images/tulsa-golden-driller.jpg',
    imageAlt: "The Golden Driller, a giant oil-worker statue and Tulsa's best-known landmark",
    credit: 'Photo: Timdayf5 / Wikimedia Commons (CC BY-SA 4.0)',
  },
  {
    eyebrow: 'Somewhere that changed you',
    title: 'A place that changed you',
    note: 'Buenos Aires, Argentina.',
    image: '/images/buenos-aires-obelisco.jpg',
    imageAlt: 'The Obelisco de Buenos Aires lit up at night on Avenida 9 de Julio',
    credit: 'Photo: Rodrigo Paredes / Wikimedia Commons (CC BY 2.0)',
    objectPosition: '50% 15%',
  },
  {
    eyebrow: 'What drives me',
    title: 'Top priorities',
    note: 'Building the best possible life for my wife, Julia, and the family we’ve chosen — mostly our dogs.',
    image: '/images/julia-and-chance.jpg',
    imageAlt: 'Julia smiling with our dog, Chance',
  },
  {
    eyebrow: 'Someone who shaped me',
    title: 'Matt Drayer',
    note: 'Placeholder — one line on what he taught you.',
    image: '/images/matt-drayer.png',
    imageAlt: 'Matt Drayer',
  },
  {
    eyebrow: 'The leap',
    title: 'Joining Webflow',
    note: 'Placeholder — the risk or change you took.',
    image: '/images/speaking-at-wfc24.jpg',
    imageAlt: 'Rob speaking on stage at Webflow Conf',
  },
  {
    eyebrow: 'Looking ahead',
    title: "What's next",
    note: 'Placeholder — a goal or curiosity.',
    compact: true,
    photoStack: [
      { src: '/images/sa-team/jordan-maslyn.png', alt: 'Jordan Maslyn', top: '2%', left: '0%', rotate: '-8deg', z: 1, size: '28%', objectPosition: '50% 20%' },
      { src: '/images/sa-team/rachel-clark.png', alt: 'Rachel Clark', top: '0%', left: '26%', rotate: '6deg', z: 2, size: '28%', objectPosition: '50% 20%' },
      { src: '/images/sa-team/christina-dulude.png', alt: 'Christina Dulude', top: '4%', left: '52%', rotate: '-5deg', z: 3, size: '28%' },
      { src: '/images/sa-team/jon-saxton.jpg', alt: 'Jon Saxton', top: '2%', left: '74%', rotate: '7deg', z: 4, size: '26%' },
      { src: '/images/sa-team/ben-parker.jpg', alt: 'Ben Parker', top: '64%', left: '2%', rotate: '6deg', z: 5, size: '28%', objectPosition: '50% 20%' },
      { src: '/images/sa-team/wadood-hussaini.jpg', alt: 'Wadood Hussaini', top: '66%', left: '34%', rotate: '-6deg', z: 6, size: '28%' },
      { src: '/images/sa-team/blake-lam.jpg', alt: 'Blake Lam', top: '62%', left: '66%', rotate: '5deg', z: 7, size: '28%' },
    ],
    selfPhoto: { src: '/images/sa-team/rob-smith.png', alt: 'Rob Smith', top: '26%', left: '30%', rotate: '-2deg', z: 8, size: '38%' },
  },
];
---

<Layout title="Rob Smith — Biography">
  <Header />
  <main>
  <section class="hero">
    {heroImage ? (
      <img src={heroImage} alt={heroImageAlt} />
    ) : (
      <div class="hero-placeholder">Photo placeholder</div>
    )}
    <div class="hero-overlay">
      <div class="hero-content">
        <h1 class="page-heading">Biography</h1>
        <p class="intro">Six chapters, sketched out — photos and captions still to come.</p>
      </div>
    </div>
  </section>

  <div class="chapters">
    {chapters.map((chapter, i) => (
      <div class:list={['chapter', i % 2 === 1 && 'chapter--reverse', chapter.compact && 'chapter--compact']}>
        <div class="chapter-media">
          {chapter.photoStack ? (
            <div class="stack-collage">
              {chapter.photoStack.map((p) => (
                <img
                  class="stack-card"
                  src={p.src}
                  alt={p.alt}
                  style={`top:${p.top}; left:${p.left}; width:${p.size}; transform: rotate(${p.rotate}); z-index:${p.z};${p.objectPosition ? ` object-position: ${p.objectPosition};` : ''}`}
                />
              ))}
              {chapter.selfPhoto && (
                <div
                  class="stack-card stack-card--self"
                  style={`top:${chapter.selfPhoto.top}; left:${chapter.selfPhoto.left}; width:${chapter.selfPhoto.size}; transform: rotate(${chapter.selfPhoto.rotate}); z-index:${chapter.selfPhoto.z};`}
                >
                  <img src={chapter.selfPhoto.src} alt={chapter.selfPhoto.alt} />
                  <span class="stack-question">?</span>
                </div>
              )}
            </div>
          ) : chapter.image ? (
            <img
              src={chapter.image}
              alt={chapter.imageAlt}
              style={chapter.objectPosition ? `object-position: ${chapter.objectPosition};` : undefined}
            />
          ) : (
            <div class="chapter-placeholder">Photo placeholder</div>
          )}
          {chapter.credit && <span class="photo-credit">{chapter.credit}</span>}
        </div>
        <div class="chapter-text">
          <span class="chapter-eyebrow">{chapter.eyebrow}</span>
          <h2 class="chapter-title">{chapter.title}</h2>
          <p class="chapter-note">{chapter.note}</p>
        </div>
      </div>
    ))}
  </div>
  </main>
  <Footer />
</Layout>

<script>
  const chapters = document.querySelectorAll('.chapter');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    chapters.forEach((chapter) => chapter.classList.add('in-view'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );

    chapters.forEach((chapter) => observer.observe(chapter));
  }
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 420px;
  }

  .hero img,
  .hero-placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero img {
    object-fit: cover;
    object-position: 50% 38%;
  }

  .hero-placeholder {
    border: 2px dashed var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0) 60%);
  }

  .hero-content {
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  .page-heading {
    color: #fff;
    font-size: 3rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }

  .intro {
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .chapters {
    margin-top: 4rem;
  }

  .chapter {
    display: flex;
    width: 100%;
    min-height: 70vh;
    margin-bottom: 4rem;
  }

  .chapter--reverse {
    flex-direction: row-reverse;
  }

  .chapter--compact {
    min-height: 34rem;
  }

  .chapter-media {
    position: relative;
    flex: 1 1 50%;
    min-width: 0;
  }

  .photo-credit {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.7rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .chapter-media > img,
  .chapter-placeholder {
    width: 100%;
    height: 100%;
    min-height: 70vh;
    display: block;
  }

  .chapter-media > img {
    object-fit: cover;
  }

  .chapter-placeholder {
    border: 2px dashed var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stack-collage {
    position: relative;
    width: 100%;
    height: 34rem;
    overflow: hidden;
  }

  .stack-card {
    position: absolute;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 10px;
    border: 4px solid var(--color-bg);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
  }

  .stack-card--self {
    display: block;
  }

  .stack-card--self img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }

  .stack-question {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-size: 3.5rem;
    font-weight: 800;
  }

  .chapter-text {
    flex: 1 1 50%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem 4rem;
    max-width: 32rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s ease 0.25s, transform 0.7s ease 0.25s;
  }

  .chapter.in-view .chapter-text {
    opacity: 1;
    transform: translateY(0);
  }

  .chapter-eyebrow {
    display: block;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .chapter-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.1;
    margin: 0.35rem 0 0.5rem;
  }

  .chapter-note {
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  @media (max-width: 700px) {
    .hero {
      height: 50vh;
      min-height: 320px;
    }

    .hero-content {
      padding: 0 1.5rem 2rem;
    }

    .page-heading {
      font-size: 2rem;
    }

    .chapters {
      margin-top: 2.5rem;
    }

    .chapter,
    .chapter--reverse {
      flex-direction: column;
      margin-bottom: 2.5rem;
    }

    .chapter-media > img,
    .chapter-placeholder {
      height: 55vh;
      min-height: 0;
    }

    .chapter--compact {
      min-height: auto;
    }

    .stack-collage {
      height: 22rem;
    }

    .stack-question {
      font-size: 2.25rem;
    }

    .chapter-text {
      padding: 2rem 1.5rem;
      max-width: none;
    }

    .chapter-title {
      font-size: 1.7rem;
    }
  }
</style>
