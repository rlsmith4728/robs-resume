---
import ExpansionChart from './ExpansionChart.astro';

const companies = [
  {
    name: 'Webflow',
    logo: '/images/webflow-logo.svg',
    logoDark: '/images/webflow-logo-white.png',
    range: 'Sep 2021 – Present',
    events: [
      {
        type: 'role',
        date: 'Sep 2021',
        title: 'Customer Success Manager',
        meta: 'Denver, CO',
        description:
          "Joined as a founding member of Webflow's Enterprise Customer Success team, working directly with our first wave of Enterprise customers.",
      },
      {
        type: 'milestone',
        date: 'Jul 2022',
        tag: 'Customer story',
        title: "Launched Greenhouse's first projects on Webflow",
        description:
          "Managed the launch of HR-tech platform Greenhouse's first projects on Webflow, laying the foundation for the growth that followed. That foundation carried into one of Webflow's flagship customer stories — their marketing team fully moved off a developer-dependent CMS, cutting $350K in annual agency costs and lifting conversion rates by up to 40%.",
        quote: {
          text: "Before Webflow, the website felt a little bit like a straitjacket... now it's more about: are we doing something that's going to have business impact?",
          author: 'Carrin Van Vuuren, CMO, Greenhouse',
        },
        link: { href: 'https://webflow.com/customers/greenhouse', label: 'Read the case study' },
      },
      {
        type: 'role',
        date: 'Feb 2023',
        title: 'Senior Customer Success Manager',
        meta: 'Philadelphia, PA (Remote)',
        description:
          'Took ownership of a book of strategic Enterprise accounts — roughly $4M in ARR, mostly across EMEA — posting 109% net revenue retention in both FY24 and FY25.',
      },
      {
        type: 'milestone',
        date: 'Sep 2023',
        tag: 'First of its kind',
        title: "Sold Webflow's first-ever Localization deal",
        description:
          "Closed the company's first Localization sale, to Moloco — helping define how Webflow would go on to sell one of its now-core Enterprise products.",
      },
      {
        type: 'milestone',
        date: 'Oct 2024',
        tag: 'Speaker',
        title: 'Spoke at Webflow Conf London',
        description:
          '"Turning your website into a revenue-generating engine" — shared the strategies my customers use to speed up time-to-market, cut maintenance costs, and optimize performance.',
        link: {
          href: 'https://webflow.com/webflowconf/2024/session/turning-your-website-into-a-revenue-generating-engine-london',
          label: 'View the session',
        },
      },
      {
        type: 'role',
        date: 'Oct 2025',
        title: 'Lead Customer Success Manager, EMEA',
        meta: 'Rotterdam, NL (Remote)',
        description:
          "Now building Webflow's Customer Success motion across EMEA from the ground up — hiring and leading the regional team without ever holding a formal manager title, all while posting the best expansion track record of any CSM at Webflow.",
        stat: 'Record for the most expansion dollars of any CSM at Webflow · at or above goal in 6 of 7 measured quarters',
        chart: true,
      },
      {
        type: 'role',
        date: 'Aug 2026',
        title: 'Lead Principal Customer Success Manager, EMEA',
        meta: 'Rotterdam, NL (Remote)',
        description: 'Still making customers successful — leadership and mentorship responsibilities continue to grow.',
      },
    ],
  },
  {
    name: 'edX',
    logo: '/images/edx-logo.svg',
    logoDark: '/images/edx-logo.svg',
    range: 'May 2018 – Aug 2021',
    events: [
      {
        type: 'role',
        date: 'May 2018',
        title: 'Customer Success Associate',
        meta: 'Cambridge, MA',
        description: 'First role in Customer Success — learned the fundamentals of managing enterprise relationships from the ground up.',
      },
      {
        type: 'role',
        date: 'Aug 2019',
        title: 'Senior Customer Success Associate',
        meta: 'Cambridge, MA',
        description:
          "Retained edX's single most strategic account, worth over $1M in ARR, and partnered with sales to close the largest net-new deal in company history — $500K in ARR, $1.5M in total contract value.",
      },
      {
        type: 'role',
        date: 'Aug 2020',
        title: 'Manager, Customer Success',
        meta: 'Denver, CO',
        description:
          'Promoted into management, leading a small team of Customer Success Associates and building the onboarding process that ramped new hires quickly.',
      },
    ],
  },
];
---

<section id="experience" class="section section--alt">
  <div class="container">
    <h2 class="section-heading">Experience</h2>
    {companies.map((company) => (
      <div class="company">
        <div class="company-header">
          {company.logoDark !== company.logo ? (
            <>
              <img class="logo swap-light" src={company.logo} alt={company.name} />
              <img class="logo swap-dark" src={company.logoDark} alt={company.name} />
            </>
          ) : (
            <img class="logo" src={company.logo} alt={company.name} />
          )}
          <span class="range">{company.range}</span>
        </div>
        <div class="timeline">
          {company.events.map((event) => (
            event.type === 'milestone' ? (
              <div class="event milestone">
                <span class="date">{event.date}</span>
                <span class="tag">{event.tag}</span>
                <h3>{event.title}</h3>
                <p class="description">{event.description}</p>
                {event.quote && (
                  <blockquote>
                    <p>“{event.quote.text}”</p>
                    <cite>— {event.quote.author}</cite>
                  </blockquote>
                )}
                {event.link && (
                  <a class="event-link" href={event.link.href} target="_blank" rel="noopener noreferrer">
                    {event.link.label} ↗
                  </a>
                )}
              </div>
            ) : (
              <div class="event role">
                <span class="date">{event.date}</span>
                <h3>{event.title}</h3>
                <p class="meta">{event.meta}</p>
                <p class="description">{event.description}</p>
                {event.stat && <p class="stat">🏆 {event.stat}</p>}
                {event.chart && <ExpansionChart />}
              </div>
            )
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .company {
    margin-bottom: 3rem;
  }

  .company:last-child {
    margin-bottom: 0;
  }

  .company-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .logo {
    height: 1.5rem;
    width: auto;
  }

  .swap-dark { display: none; }
  :global(html.dark) .swap-light { display: none; }
  :global(html.dark) .swap-dark { display: inline; }

  .range {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .timeline {
    position: relative;
    padding-left: 1.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.28rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    background: var(--color-border);
  }

  .event {
    position: relative;
    margin-bottom: 1.75rem;
  }

  .event:last-child {
    margin-bottom: 0;
  }

  .event::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 0.35rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-border);
  }

  .event.milestone::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  .date {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .event h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin: 0 0 0.5rem;
  }

  .description {
    color: var(--color-text-muted);
    margin: 0;
  }

  .role .description {
    margin-top: 0.15rem;
  }

  .stat {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.85rem;
    background: var(--color-accent-soft);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .milestone {
    padding: 1rem 1.1rem;
    background: var(--color-accent-soft);
    border-radius: 8px;
  }

  .milestone .date {
    display: inline;
    margin-right: 0.6rem;
  }

  .tag {
    display: inline-block;
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .milestone h3 {
    margin-top: 0.35rem;
  }

  blockquote {
    margin: 0.75rem 0 0;
    padding-left: 0.85rem;
    border-left: 2px solid var(--color-accent);
  }

  blockquote p {
    margin: 0;
    font-style: italic;
    color: var(--color-text);
    font-size: 0.9rem;
  }

  blockquote cite {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-style: normal;
  }

  .event-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .event-link:hover {
    text-decoration: underline;
  }
</style>
