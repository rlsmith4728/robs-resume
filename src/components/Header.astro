---
import ThemeToggle from './ThemeToggle.astro';

const pageLinks = [
  { href: '/', label: 'Resume' },
  { href: '/biography', label: 'Biography' },
];

const currentPath = Astro.url.pathname;
---

<header>
  <div class="container nav-inner">
    <a href="/" class="logo">Rob Smith</a>
    <nav id="primaryNav">
      {pageLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link nav-link--page"
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="right-group">
      <button id="navToggle" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="primaryNav">
        <svg class="icon-open" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg class="icon-close" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline>
  const navToggle = document.getElementById('navToggle');
  const primaryNav = document.getElementById('primaryNav');

  navToggle?.addEventListener('click', () => {
    const isOpen = primaryNav.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', String(isOpen));
  });

  primaryNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      primaryNav.classList.remove('open');
      navToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .logo {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
  }

  nav {
    align-items: center;
  }

  .nav-link--page {
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent-on-soft);
    background: var(--color-accent-soft);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .nav-link--page:hover {
    background: var(--color-accent-solid);
    color: var(--color-accent-text);
  }

  .nav-link--page[aria-current='page'] {
    background: var(--color-accent-solid);
    color: var(--color-accent-text);
  }

  .right-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .icon-close {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] .icon-open {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  @media (max-width: 640px) {
    .nav-toggle {
      display: flex;
    }

    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
      padding: 0.75rem 1.5rem 1rem;
    }

    nav.open {
      display: flex;
    }

    .nav-link--page {
      width: 6.5rem;
      text-align: center;
    }
  }
</style>
